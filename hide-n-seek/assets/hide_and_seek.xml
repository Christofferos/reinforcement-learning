<!--
  Hide and Seek MuJoCo Environment
  ═══════════════════════════════════════════════════════════════════
  Inspired by OpenAI's "Emergent Tool Use From Multi-Agent Autocurricula" (2019)

  Layout (top-down, Y points up):
  ┌────────────────────────────────────────────┐
  │                                            │
  │   ROOM NW (seekers start)    │   ROOM NE   │
  │   (open area — no roof)      ╡D           │
  │                              │             │
  │──────────╡D   ───────────────┤             │
  │                              │─────╡D──────│
  │                              │             │
  │   ROOM SW                    │   ROOM SE   │
  │                     D╞───────┤   (hiders)  │
  │                              │             │
  └────────────────────────────────────────────┘

  - 3 corner rooms (NE, SE, SW) each with 1–2 door gaps
  - 1 open quadrant (NW) where seekers spawn
  - Hiders start in SE room; seekers start in NW open area
  - Boxes placed near room doors so hiders can barricade
  - Ramps placed in open area (seekers can use to bypass walls)

  Color palette matched to hidenseek-html-mockup.html:
    sky/fog  #2a2a3e    floor  #37474f    wall  #546e7a
    box      #8d8d8d    ramp   #81c784
    hider    #4fc3f7    seeker #ef5350
    sun      #fff5e0    ambient 50%
-->
<mujoco model="hide_and_seek">
  <compiler angle="radian" coordinate="local" inertiafromgeom="true"/>

  <option timestep="0.02" gravity="0 0 -9.81" integrator="Euler">
    <flag warmstart="enable"/>
  </option>

  <default>
    <geom condim="6" friction="0.4 0.3 0.1" margin="0.001"/>
    <joint damping="0.5" armature="0.01"/>
    <motor ctrllimited="true" ctrlrange="-1.0 1.0"/>
  </default>

  <!-- ═══════════════════ ASSETS ═══════════════════ -->
  <asset>
    <!-- Sky: dark indigo #2a2a3e -->
    <texture type="skybox" builtin="gradient"
             rgb1="0.165 0.165 0.243" rgb2="0.06 0.06 0.10"
             width="512" height="512"/>
    <!-- Ground: uniform grey tile -->
    <texture name="groundplane" type="2d" builtin="flat"
             rgb1="0.24 0.30 0.34" rgb2="0.24 0.30 0.34"
             width="64" height="64"/>
    <material name="groundplane" texture="groundplane"
              texuniform="true" reflectance="0" shininess="0"
              specular="0" emission="0"/>
    <!-- Walls: slate #546e7a -->
    <material name="wall_mat"   rgba="0.329 0.431 0.478 1" reflectance="0.12" shininess="0.15"/>
    <!-- Hiders: cyan #4fc3f7 -->
    <material name="hider_mat"  rgba="0.310 0.765 0.969 1" reflectance="0.30" shininess="0.6" specular="0.4"/>
    <!-- Seekers: red #ef5350 -->
    <material name="seeker_mat" rgba="0.937 0.325 0.314 1" reflectance="0.30" shininess="0.6" specular="0.4"/>
    <!-- Boxes: grey #8d8d8d -->
    <material name="box_mat"    rgba="0.553 0.553 0.553 1" reflectance="0.08" shininess="0.15"/>
    <!-- Ramps: green #81c784 -->
    <material name="ramp_mat"   rgba="0.506 0.780 0.518 1" reflectance="0.08" shininess="0.15"/>
    <!-- Locked: magenta -->
    <material name="locked_mat" rgba="0.85 0.20 0.85 1" reflectance="0.20" shininess="0.4"/>
    <!-- Ramp wedge mesh (triangular prism — convex hull of 6 vertices) -->
    <mesh name="ramp_wedge_0"
          vertex="-1.2000 -0.4000 -0.2833  -1.2000  0.4000 -0.2833
                   1.2000 -0.4000 -0.2833   1.2000  0.4000 -0.2833
                   1.2000 -0.4000  0.5667   1.2000  0.4000  0.5667"/>
  </asset>

  <!-- ═══════════════════ VISUAL ═══════════════════ -->
  <visual>
    <global offwidth="1280" offheight="720"/>
    <quality shadowsize="4096"/>
    <headlight ambient="0.35 0.35 0.38" diffuse="0.30 0.30 0.33" specular="0.08 0.08 0.08"/>
  </visual>

